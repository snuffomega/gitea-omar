#!/usr/bin/env bash
# Gitea work-status collector — fetches PRs, reviews, and CI status
# Writes JSON to $XDG_STATE_HOME/omarchy/gitea-workstatus/overview.json
# Reads token from $XDG_CONFIG_HOME/gitea-workstatus/credentials
# Target: Gitea >= 1.19. Actions runs require >= 1.20.
# Runtime deps: bash, curl, jq (>= 1.6), flock, coreutils
set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/gitea-workstatus"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/gitea-workstatus"
CRED_FILE="$CONFIG_DIR/credentials"
OUTPUT="$STATE_DIR/overview.json"
LOCK_FILE="$STATE_DIR/.collect.lock"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
JQ_SCRIPT="$SCRIPT_DIR/gitea-collect.jq"

MAX_STALE_HOURS="${GITEA_WS_MAX_STALE_HOURS:-6}"

mkdir -p "$STATE_DIR" "$CONFIG_DIR"

# --- flock-based mutual exclusion ---
exec 9>"$LOCK_FILE"
flock -n 9 || { echo "Another collector is running"; exit 0; }

# --- Atomic write: temp + rename ---
atomic_write() {
  local dest="$1" content="$2"
  local tmpfile
  tmpfile=$(mktemp "${dest}.XXXXXX")
  printf '%s\n' "$content" > "$tmpfile"
  mv -f "$tmpfile" "$dest"
}

# --- Error: preserve last-good data, write error alongside ---
die() {
  local err="{\"error\": \"$1\", \"ts\": \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"}"
  atomic_write "$STATE_DIR/last-error.json" "$err"
  if [ ! -f "$OUTPUT" ]; then
    atomic_write "$OUTPUT" "$err"
  fi
  exit 1
}

if [ ! -f "$CRED_FILE" ]; then
  die "No credentials file. Create $CRED_FILE with GITEA_URL and GITEA_TOKEN."
fi

# shellcheck source=/dev/null
source "$CRED_FILE"

GITEA_URL="${GITEA_URL:-}"
GITEA_TOKEN="${GITEA_TOKEN:-}"

[ -z "$GITEA_URL" ] && die "GITEA_URL not set in $CRED_FILE"
[ -z "$GITEA_TOKEN" ] && die "GITEA_TOKEN not set in $CRED_FILE"

GITEA_URL="${GITEA_URL%/}"

# --- API helpers ---
# api ENDPOINT [PAGE] [LIMIT] [EXTRA_PARAMS]
# Returns body on stdout. Exit 1 on transport/HTTP failure.
api() {
  local endpoint="$1"
  local page="${2:-1}"
  local limit="${3:-50}"
  local extra="${4:-}"
  local url="${GITEA_URL}/api/v1${endpoint}?page=${page}&limit=${limit}"
  if [ -n "$extra" ]; then
    url="${url}&${extra}"
  fi
  local response http_code body
  response=$(curl -sS --max-time 15 -w '\n%{http_code}' \
    -H "Authorization: token $GITEA_TOKEN" \
    -H "Accept: application/json" \
    "$url" 2>/dev/null) || return 1

  http_code=$(echo "$response" | tail -1)
  body=$(echo "$response" | sed '$d')

  [ "$http_code" = "200" ] || return 1
  echo "$body"
}

# api_paginated ENDPOINT LIMIT MAX_PAGES [EXTRA_PARAMS]
# Prints merged JSON array. Exit 0 if >=1 page succeeded. When coverage ended
# early because a non-200 page interrupted pagination, API_COVERAGE=PARTIAL is
# set (usable when called without command substitution).
api_paginated() {
  local endpoint="$1"
  local limit="${2:-50}"
  local max_pages="${3:-5}"
  local extra="${4:-}"
  local all="[]"
  local page=1
  local pages_ok=0

  API_COVERAGE="COMPLETE"

  while [ "$page" -le "$max_pages" ]; do
    local url="${GITEA_URL}/api/v1${endpoint}?page=${page}&limit=${limit}"
    if [ -n "$extra" ]; then
      url="${url}&${extra}"
    fi
    local response
    if ! response=$(curl -sS --max-time 15 -w '\n%{http_code}' \
      -H "Authorization: token $GITEA_TOKEN" \
      -H "Accept: application/json" \
      "$url" 2>/dev/null); then
      API_COVERAGE="PARTIAL"
      break
    fi

    local http_code body
    http_code=$(echo "$response" | tail -1)
    body=$(echo "$response" | sed '$d')

    if [ "$http_code" != "200" ]; then
      API_COVERAGE="PARTIAL"
      break
    fi

    local count
    count=$(echo "$body" | jq 'if type == "array" then length else 0 end' 2>/dev/null) || break
    [ "$count" -eq 0 ] && { pages_ok=$((pages_ok + 1)); break; }

    all=$(echo "$all" "$body" | jq -s '.[0] + .[1]')
    pages_ok=$((pages_ok + 1))
    [ "$count" -lt "$limit" ] && break
    page=$((page + 1))
  done

  echo "$all"
  [ "$pages_ok" -gt 0 ] && return 0 || return 1
}

fetch_user() {
  api "/user"
}

fetch_repos() {
  api_paginated "/user/repos" 50 10
}

fetch_prs_for_repo() {
  local owner="$1" repo="$2"
  api_paginated "/repos/${owner}/${repo}/pulls" 30 3 "state=open"
}

fetch_reviews_for_pr() {
  local owner="$1" repo="$2" index="$3"
  api_paginated "/repos/${owner}/${repo}/pulls/${index}/reviews" 50 3
}

fetch_commit_status() {
  local owner="$1" repo="$2" sha="$3"
  api "/repos/${owner}/${repo}/commits/${sha}/status"
}

fetch_action_runs() {
  local owner="$1" repo="$2"
  api "/repos/${owner}/${repo}/actions/runs" 1 20
}

# fetch_action_runs_with_code: first line is HTTP code or sentinel, rest is body.
# Never manufacture 404 on transport failure. 404 means "Actions not enabled" (ok).
# Non-200 HTTP (e.g. 500) and TRANSPORT both mean "failure" (partial).
fetch_action_runs_with_code() {
  local owner="$1" repo="$2"
  local url="${GITEA_URL}/api/v1/repos/${owner}/${repo}/actions/runs?page=1&limit=20"
  local response http_code
  if ! response=$(curl -sS --max-time 15 -w '\n%{http_code}' \
    -H "Authorization: token $GITEA_TOKEN" \
    -H "Accept: application/json" \
    "$url" 2>/dev/null); then
    echo "TRANSPORT"
    return 0
  fi
  http_code=$(echo "$response" | tail -1)
  echo "${http_code}"
  echo "$response" | sed '$d'
  return 0
}

now_ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)

user_json=$(fetch_user) || die "Cannot authenticate with Gitea"
username=$(echo "$user_json" | jq -r '.login // empty')
[ -z "$username" ] && die "Cannot determine username"

# Run fetch_repos without command substitution so API_COVERAGE set inside
# api_paginated survives ($() spawns a subshell, dropping shell globals).
unset API_COVERAGE
API_COVERAGE="COMPLETE"
repos_json_tmp=$(mktemp)
if ! fetch_repos > "$repos_json_tmp"; then
  rm -f "$repos_json_tmp"
  die "Cannot list repositories"
fi
repos_json=$(cat "$repos_json_tmp")
rm -f "$repos_json_tmp"
repos_coverage="$API_COVERAGE"
repo_count=$(echo "$repos_json" | jq 'length')

if ! echo "$repos_json" | jq -e 'type == "array"' >/dev/null 2>&1; then
  die "Unexpected repos response shape"
fi

tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT

idx=0
repo_attempted=0

for row in $(echo "$repos_json" | jq -r '.[] | @base64'); do
  decoded=$(echo "$row" | base64 -d)
  owner=$(echo "$decoded" | jq -r '.owner.login')
  repo=$(echo "$decoded" | jq -r '.name')
  has_prs=$(echo "$decoded" | jq -r '.has_pull_requests // true')

  repo_attempted=$((repo_attempted + 1))

  (
    repo_status="ok"

    # Fetch PRs (skip if repo has PRs disabled)
    if [ "$has_prs" != "false" ]; then
      prs=$(fetch_prs_for_repo "$owner" "$repo" 2>/dev/null) || { prs="[]"; repo_status="partial"; }

      if echo "$prs" | jq -e 'type == "array"' >/dev/null 2>&1; then
        pr_count=$(echo "$prs" | jq 'length')

        for i in $(seq 0 $((pr_count - 1))); do
          pr_index=$(echo "$prs" | jq -r ".[$i].number")
          pr_sha=$(echo "$prs" | jq -r ".[$i].head.sha // empty")

          reviews=$(fetch_reviews_for_pr "$owner" "$repo" "$pr_index" 2>/dev/null) || reviews="[]"
          if ! echo "$reviews" | jq -e 'type == "array"' >/dev/null 2>&1; then
            reviews="[]"
          fi

          commit_status="{}"
          if [ -n "$pr_sha" ]; then
            commit_status=$(fetch_commit_status "$owner" "$repo" "$pr_sha" 2>/dev/null) || commit_status="{}"
          fi

          prs=$(echo "$prs" | jq --argjson idx "$i" \
            --argjson revs "$reviews" \
            --argjson cs "$commit_status" \
            '.[$idx]._reviews = $revs | .[$idx]._commit_status = $cs')
        done

        prs=$(echo "$prs" | jq --arg fn "${owner}/${repo}" '[.[] | . + {"_repo": $fn}]')
      else
        prs="[]"
        repo_status="partial"
      fi
    else
      prs="[]"
    fi

    echo "$prs" > "$tmpdir/prs_${idx}.json"

    # Always attempt Actions runs regardless of has_pull_requests.
    # Only HTTP 404 means "Actions not enabled" (ok). Anything else
    # non-200 (500, TRANSPORT failure, etc.) is a failure -> partial.
    runs_output=$(fetch_action_runs_with_code "$owner" "$repo")
    runs_http_code=$(echo "$runs_output" | head -1)
    runs_raw=$(echo "$runs_output" | sed '1d')

    if [ "$runs_http_code" = "200" ] && [ -n "$runs_raw" ] && echo "$runs_raw" | jq -e '.workflow_runs' >/dev/null 2>&1; then
      echo "$runs_raw" | jq --arg fn "${owner}/${repo}" \
        '[.workflow_runs[]? | . + {"_repo": $fn}]' > "$tmpdir/runs_${idx}.json"
    elif [ "$runs_http_code" = "200" ] && [ -n "$runs_raw" ] && echo "$runs_raw" | jq -e 'type == "array"' >/dev/null 2>&1; then
      echo "$runs_raw" | jq --arg fn "${owner}/${repo}" \
        '[.[]? | . + {"_repo": $fn}]' > "$tmpdir/runs_${idx}.json"
    else
      echo "[]" > "$tmpdir/runs_${idx}.json"
      if [ "$runs_http_code" != "404" ]; then
        repo_status="partial"
      fi
    fi

    echo "$repo_status" > "$tmpdir/status_${idx}"
  ) &

  idx=$((idx + 1))

  if [ $((idx % 8)) -eq 0 ]; then
    wait
  fi
done

wait

# Merge all results
all_prs="[]"
all_runs="[]"
for f in "$tmpdir"/prs_*.json; do
  [ -f "$f" ] || continue
  content=$(cat "$f")
  all_prs=$(echo "$all_prs" "$content" | jq -s '.[0] + .[1]')
done

for f in "$tmpdir"/runs_*.json; do
  [ -f "$f" ] || continue
  content=$(cat "$f")
  all_runs=$(echo "$all_runs" "$content" | jq -s '.[0] + .[1]')
done

# Count failures
repo_failed=0
for f in "$tmpdir"/status_*; do
  [ -f "$f" ] || continue
  if [ "$(cat "$f")" != "ok" ]; then
    repo_failed=$((repo_failed + 1))
  fi
done

incomplete=false
[ "$repos_coverage" = "PARTIAL" ] && incomplete=true

# Carry-forward engages on failure or incomplete coverage — never on empty lists.
if [ "$repos_coverage" = "PARTIAL" ] && [ "$repo_attempted" -gt 0 ] && [ -f "$OUTPUT" ]; then
  prev_ts=$(jq -r '.meta.collected_at // empty' "$OUTPUT" 2>/dev/null || echo "")
  if [ -n "$prev_ts" ]; then
    prev_epoch=$(date -d "$prev_ts" +%s 2>/dev/null || echo 0)
    now_epoch=$(date +%s)
    hours_old=$(( (now_epoch - prev_epoch) / 3600 ))
    if [ "$hours_old" -lt "$MAX_STALE_HOURS" ]; then
      stale_tmp=$(mktemp "$OUTPUT.XXXXXX")
      jq --arg ts "$now_ts" '.meta.stale = true | .meta.stale_since = $ts' "$OUTPUT" > "$stale_tmp"
      mv -f "$stale_tmp" "$OUTPUT"
      echo "Stale carry-forward at $now_ts (data ${hours_old}h old)"
      exit 0
    fi
  fi
fi

overview=$(jq -n \
  --arg url "$GITEA_URL" \
  --arg user "$username" \
  --arg ts "$now_ts" \
  --argjson prs "$all_prs" \
  --argjson runs "$all_runs" \
  --argjson repo_count "$repo_count" \
  --argjson max_stale "$MAX_STALE_HOURS" \
  --argjson repo_failed "$repo_failed" \
  --argjson repo_attempted "$repo_attempted" \
  --argjson incomplete "$incomplete" \
  -f "$JQ_SCRIPT")

atomic_write "$OUTPUT" "$overview"
rm -f "$STATE_DIR/last-error.json"
echo "Collected: $pr_count_now PRs, $run_count_now runs ($repo_failed/$repo_attempted repos partial) at $now_ts"
